%% Berry Exchange — C4 Level 3: Components inside the SPA container
graph LR
    subgraph SPA["React SPA"]
        direction TB
        Routes["Routes: /market /sell /sell/:id /reservations /login"]
        subgraph Features
            Market["Market feature<br/>listing grid, filters, search, qty picker, buy"]
            Sell["Sell feature<br/>create/edit listing form, photo upload"]
            Reservations["Reservations feature<br/>buy action, my reservations"]
            Auth["Auth feature<br/>login/register"]
        end
        ApiClient["API client layer<br/>(TanStack Query + fetch wrapper, JSON + multipart FormData)"]
        ListingCard["ListingCard<br/>(shared card: photo/BerryIcon, price, footer slot)"]
        UI["Shared UI kit<br/>(design tokens from global.css: colors, buttons, chips, cards)"]
        Theme["ThemeProvider / ThemeToggle<br/>(light/dark/system, .dark class + localStorage)"]
        Glow["GlowingEffect<br/>(pointer-tracked card border, motion)"]
    end
    API[("Berry Exchange API")]

    Routes --> Features
    Features --> ApiClient
    Market --> ListingCard
    Reservations --> ListingCard
    ListingCard --> UI
    Features --> UI
    UI --> Theme
    UI --> Glow
    ApiClient -->|"HTTPS JSON + multipart"| API
