%% Berry Exchange — C4 Level 2: Containers
graph TB
    subgraph Client
        Browser["React SPA<br/>(Buyer & Seller UI)"]
    end
    subgraph Edge
        Proxy["Reverse Proxy (Caddy)<br/>TLS, static hosting, /api/* routing"]
    end
    subgraph Backend
        API["ASP.NET Core Web API<br/>Berry Exchange"]
        McpServer["BerryExchange.McpServer<br/>MCP server (stdio)<br/>search_listings, get_listing,<br/>check_availability, create_reservation"]
    end
    subgraph Data
        DB[("PostgreSQL")]
    end
    subgraph "External Agents"
        McpClient(["MCP client<br/>(e.g. Claude Desktop, Claude Code)"])
    end

    Browser <-->|HTTPS| Proxy
    Proxy -->|serves SPA bundle| Browser
    Proxy -->|"/api/* reverse-proxied"| API
    API -->|"EF Core / Npgsql"| DB
    McpClient -->|"stdio (JSON-RPC / MCP)"| McpServer
    McpServer -->|"HTTP (public API)<br/>cookie auth for create_reservation"| API

    %% --- Local / demo topology (ADR-0008): docker-compose, no separate edge proxy ---
    subgraph "Docker Compose (local / demo stack)"
        ComposeBrowser["Browser<br/>(developer machine)"]
        FrontendContainer["frontend container<br/>nginx: serves built SPA bundle<br/>and proxies /api/ to api<br/>(built with VITE_GOOGLE_CLIENT_ID)"]
        ApiContainer["api container<br/>ASP.NET Core Web API<br/>(Database:AutoMigrate=true,<br/>Authentication:Google:ClientId)"]
        PostgresContainer[("postgres container<br/>pgvector/pgvector:pg16")]
        RabbitMqContainer{{"rabbitmq container<br/>rabbitmq:4-management<br/>berry.events topic exchange"}}
        AiWorkerContainer["ai-worker container<br/>.NET Worker Service<br/>(BerryExchange.AiWorker)"]
    end

    ComposeBrowser -->|"http://localhost:5173"| FrontendContainer
    FrontendContainer -->|serves SPA bundle| ComposeBrowser
    FrontendContainer -->|"/api/* proxy_pass"| ApiContainer
    ApiContainer -->|"EF Core / Npgsql<br/>Host=postgres"| PostgresContainer
    ApiContainer -->|"publishes listing.created<br/>AMQP"| RabbitMqContainer
    AiWorkerContainer -->|"consumes ai-enrichment queue<br/>AMQP"| RabbitMqContainer
