%% Berry Exchange — C4 Level 3: Components inside the API container
graph LR
    subgraph API["ASP.NET Core Web API"]
        direction TB
        Endpoints["Minimal API endpoints<br/>(Listings, Reservations, Accounts)"]
        subgraph App["Application layer"]
            ListingsSvc[ListingsService]
            ResSvc[ReservationsService]
            AccountsSvc["AccountsService (wraps Identity)"]
        end
        subgraph Domain["Domain"]
            ListingEntity[Listing]
            ReservationEntity[Reservation]
            UserEntity[User]
        end
        Infra["Infrastructure<br/>EF Core DbContext, Identity stores, Migrations"]
        Messaging["Messaging (IEventPublisher)"]
        Ai["Ai module<br/>(/api/ai/status, listing assistant)"]
    end
    AiCore["BerryExchange.AiCore (embeddings + generative AI)<br/>ITextEmbedder / LocalTextEmbedder<br/>IGenerativeAi / AnthropicGenerativeAi / DisabledGenerativeAi<br/>shared with AiWorker"]
    DB[("PostgreSQL<br/>+ pgvector")]
    Broker[("RabbitMQ<br/>berry.events exchange")]
    Claude[("Claude API<br/>claude-opus-5")]

    Endpoints --> App
    Endpoints --> Ai
    App --> Domain
    App --> Infra
    Infra --> DB
    App --> Messaging
    Messaging --> Broker
    App --> AiCore
    Ai --> AiCore
    AiCore --> Claude
